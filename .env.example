# ---------------------------------------------------------------------------
# PocketSmart AI - environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------
# Generate a real secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false
PORT=5000

# Set to true to let visitors plan without creating an account.
ALLOW_GUEST=false

# --- Google Gemini ---------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id. The spec targets the Gemini 1.5 "Flash Pro" family; note that the
# 1.5 models were retired in 2025, so the default here is the current
# multimodal equivalent. Any multimodal model id works, e.g.
#   gemini-2.5-flash           (default - fast, cheap, multimodal)
#   gemini-2.5-flash-lite      (cheapest)
#   gemini-2.5-pro             (highest quality, slower/costlier)
#   gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Generation controls
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=3

# --- Storage ---------------------------------------------------------------
# Directory for the SQLite database (created automatically).
DATA_DIR=data
DATABASE_PATH=data/pocketsmart.db

# --- Uploads ---------------------------------------------------------------
MAX_CONTENT_LENGTH_MB=8
MAX_IMAGE_DIMENSION=1600
